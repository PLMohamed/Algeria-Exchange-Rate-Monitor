PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algeria_exchange_rate_monitor

# Run pending migrations on app start (deployed environments only; local dev uses `db:push`)
MIGRATE=false

# Shared secret for POST /api/v1/rates/ingest (x-cron-secret header or Bearer token)
CRON_SECRET=change-me

# Directory containing the historical archive CSVs (relative to the API working directory)
ARCHIVE_DIR=archive
